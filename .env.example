# =============================================================================
# MASC environment configuration
# Copy to `.env` and fill in only what you need. Never commit your `.env`.
# Every setting in src/config/settings.py can be overridden here (UPPER_SNAKE_CASE).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM provider API keys (only for the providers you use; Ollama needs none)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# 2. Security
# -----------------------------------------------------------------------------
# Bearer token for the API and login password for the Gradio Studio.
# Strongly recommended for any deployment reachable by others.
MASC_API_KEY=
# Rate limit per client IP (0 disables). Only trust X-Forwarded-For when MASC
# runs behind a reverse proxy that overwrites the header.
# RATE_LIMIT_PER_MINUTE=60
# TRUST_PROXY_HEADERS=false
# CORS_ORIGINS='["https://your-frontend.example.com"]'
# Custom LLM endpoints are allowlisted to prevent SSRF / key exfiltration.
# ALLOWED_BASE_URLS='["http://localhost:11434","http://127.0.0.1:11434","http://host.docker.internal:11434"]'
# ALLOW_CUSTOM_BASE_URLS=false

# -----------------------------------------------------------------------------
# 3. State persistence (LangGraph checkpointer)
# -----------------------------------------------------------------------------
# memory:// (default) keeps a bounded in-process store. For durable state use
# PostgreSQL; both postgresql:// and postgresql+psycopg:// are accepted.
# Docker Compose sets this automatically.
# DATABASE_URL=postgresql://masc_user:masc_pass@localhost:5432/masc_db
# PG_POOL_MAX_SIZE=20
# Used by docker-compose.yml for the bundled PostgreSQL container:
# POSTGRES_USER=masc_user
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=masc_db

# -----------------------------------------------------------------------------
# 4. Engine defaults & limits (optional)
# -----------------------------------------------------------------------------
# DEFAULT_PROVIDER=OpenAI
# DEFAULT_MODEL=gpt-5.2-pro
# DEFAULT_TEMPERATURE=0.1
# DEFAULT_MAX_TOKENS=4096
# MAX_ADVERSARIES=5
# MAX_TURNS_LIMIT=10
# MAX_TASK_LENGTH=100000
# MAX_CONCURRENT_LLM_CALLS=10
# LLM_RETRY_ATTEMPTS=3
# MASC_PERSONAS_FILE=custom_personas.json
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 5. Observability (optional, Langfuse SDK v3+)
# -----------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
